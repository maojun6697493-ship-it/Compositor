    "Strength": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强度"
          }
        }
      }
    },
    "Strengthens or weakens every color by the same amount.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以相同幅度加强或减弱每种颜色。"
          }
        }
      }
    },
    "Strengthens or weakens the blue primary.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加强或减弱蓝原色。"
          }
        }
      }
    },
    "Strengthens or weakens the green primary.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加强或减弱绿原色。"
          }
        }
      }
    },
    "Strengthens or weakens the red primary.": {
      "localizations": {
