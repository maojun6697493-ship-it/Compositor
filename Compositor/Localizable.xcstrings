    },
    "Adjusts the bright parts of the picture. Hold Option to see clipped highlights.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整画面的亮部。按住 Option 可查看被修剪的高光。"
