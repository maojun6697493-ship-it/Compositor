    "Swap colors": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交换颜色"
          }
        }
      }
    },
    "Swap foreground and background (X)": {
      "localizations": {
        "zh-Hans": {
